# Copy to .env. These values match docker-compose.yml (local development only).
DATABASE_URL="postgresql://khelspot:khelspot@localhost:5433/khelspot?schema=public"

# Database for `npm test` API tests. They delete all bookings, so never point this at real data.
TEST_DATABASE_URL="postgresql://khelspot:khelspot@localhost:5433/khelspot_test?schema=public"

# Port the API listens on (the Frontend dev server uses 3000).
PORT=4000

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS="http://localhost:3000"

# Copy to .env. These values match docker-compose.yml (local development only).
DATABASE_URL="postgresql://khelspot:khelspot@localhost:5433/khelspot?schema=public"

# Database for `npm test` API tests. They delete all bookings, so never point this at real data.
TEST_DATABASE_URL="postgresql://khelspot:khelspot@localhost:5433/khelspot_test?schema=public"

# Port the API listens on (the Frontend dev server uses 3000).
PORT=4000

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS="http://localhost:3000"

# ---------- Sign-in ----------
# Secret mixed into stored sign-in code hashes. Required in production; any long random string.
# OTP_SECRET="change-me"

# Local development only: POST /auth/otp also returns { devCode } so you can sign in without SMS.
# Ignored when NODE_ENV=production.
OTP_DEV_ECHO=1

# Where sign-in codes go. "console" writes them to the server log (no real SMS yet).
SMS_PROVIDER=console

# Venue owners, as venueId:phone pairs. `npm run db:seed` adds them to venue_owners.
# OWNER_PHONES="v-night-owl:03001112233,v-baseline:03002223344"

# ---------- Payments ----------
# "test" serves a fake checkout page (default outside production). Production refuses
# to start without a real provider unless ALLOW_TEST_PAYMENTS=1 (demo deployments only).
PAYMENT_PROVIDER=test
# ALLOW_TEST_PAYMENTS=1

# Where payment pages may send players back to: scheme prefixes or exact origins.
PAYMENT_RETURN_ALLOW="khelspot://,http://localhost:3000,http://localhost:8081"

# Public base URL for payment links. Defaults to the host the request came in on.
# PUBLIC_BASE_URL="https://api.khelspot.example"

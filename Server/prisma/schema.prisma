// KhelSpot database schema.
//
// Hours: a booking's `startHour` is counted from midnight of its operating
// day and can run past 24, so a venue open 4 PM to 4 AM has openHour 16 and
// closeHour 28, and a 1 AM slot on Monday's operating day is startHour 25.
//
// Double booking is blocked by an exclusion constraint added in the first
// migration (booking_no_overlap): two confirmed bookings on the same court
// cannot have overlapping hour ranges.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Sport {
  padel
  futsal
  cricket
  badminton
}

enum PaymentMethod {
  jazzcash
  easypaisa
  card
  cash
}

enum BookingStatus {
  /// Online payment started; the slot is held until holdExpiresAt.
  pending_payment
  confirmed
  cancelled
}

enum BookingSource {
  online
  walk_in
}

model Venue {
  id                String       @id
  slug              String       @unique
  name              String
  city              String
  area              String
  address           String
  description       String
  amenities         String[]
  /// Operating-day hours; closeHour may exceed 24 (e.g. 28 = 4 AM next day).
  openHour          Int          @map("open_hour")
  closeHour         Int          @map("close_hour")
  /// Full refund when cancelled at least this many hours before start.
  freeCancelHours   Int          @map("free_cancel_hours")
  /// Refund percent when cancelled later than that, before start.
  lateRefundPercent Int          @map("late_refund_percent")
  payAtVenue        Boolean      @map("pay_at_venue")
  /// Cover photo (path or URL); null until the venue has one. Credit fields are for stock photos.
  photoSrc          String?      @map("photo_src")
  photoAlt          String?      @map("photo_alt")
  photoCredit       String?      @map("photo_credit")
  photoCreditUrl    String?      @map("photo_credit_url")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  courts            Court[]
  rateBands         RateBand[]
  bookings          Booking[]
  owners            VenueOwner[]

  @@index([city, area])
  @@map("venues")
}

model Court {
  id       String    @id
  venueId  String    @map("venue_id")
  name     String
  sport    Sport
  venue    Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([venueId])
  @@map("courts")
}

/// Price per hour for one sport at one venue, between two operating-day hours.
model RateBand {
  id       Int    @id @default(autoincrement())
  venueId  String @map("venue_id")
  sport    Sport
  fromHour Int    @map("from_hour")
  toHour   Int    @map("to_hour")
  price    Int
  label    String
  venue    Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, sport])
  @@map("rate_bands")
}

model Customer {
  id        String    @id @default(uuid())
  name      String
  /// Pakistani mobile number, normalised to 03XXXXXXXXX.
  phone     String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  bookings  Booking[]

  @@map("customers")
}

model Booking {
  id              String        @id @default(uuid())
  ref             String        @unique
  venueId         String        @map("venue_id")
  courtId         String        @map("court_id")
  customerId      String        @map("customer_id")
  /// Operating day (Lahore date the session belongs to).
  date            DateTime      @db.Date
  startHour       Int           @map("start_hour")
  hours           Int
  /// Rs, fixed at booking time.
  price           Int
  payment         PaymentMethod
  paid            Boolean
  status          BookingStatus @default(confirmed)
  source          BookingSource
  createdAt       DateTime      @default(now()) @map("created_at")
  cancelledAt     DateTime?     @map("cancelled_at")
  /// Rs refunded on cancellation.
  refund          Int?
  /// pending_payment only: the hold is released (booking cancelled) after this.
  holdExpiresAt   DateTime?     @map("hold_expires_at")
  /// Where the payment page sends the player back to (allow-listed).
  returnUrl       String?       @map("return_url")
  /// Payment provider that handled the checkout ("test", later "jazzcash"...).
  paymentProvider String?       @map("payment_provider")
  venue           Venue         @relation(fields: [venueId], references: [id])
  court           Court         @relation(fields: [courtId], references: [id])
  customer        Customer      @relation(fields: [customerId], references: [id])

  @@index([venueId, date])
  @@index([courtId, date])
  @@index([customerId])
  @@index([status, holdExpiresAt])
  @@map("bookings")
}

/// Anyone who has signed in with a phone code (players and venue owners).
model User {
  /// Pakistani mobile number, normalised to 03XXXXXXXXX.
  phone     String    @id
  name      String?
  createdAt DateTime  @default(now()) @map("created_at")
  sessions  Session[]

  @@map("users")
}

/// A signed-in device. Only a SHA-256 hash of the bearer token is stored.
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  phone     String
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [phone], references: [phone], onDelete: Cascade)

  @@index([phone])
  @@map("sessions")
}

/// One-time sign-in codes. Only an HMAC of the code is stored.
model OtpCode {
  id        String    @id @default(uuid())
  phone     String
  codeHash  String    @map("code_hash")
  attempts  Int       @default(0)
  createdAt DateTime  @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  @@index([phone, createdAt])
  @@map("otp_codes")
}

/// Which phone numbers manage which venue. The owner needn't have signed in yet.
model VenueOwner {
  phone   String
  venueId String @map("venue_id")
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([phone, venueId])
  @@index([venueId])
  @@map("venue_owners")
}
